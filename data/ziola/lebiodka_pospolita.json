  "cechy_i_historia": {
    "opis": "Lebiodka (oregano) była świętą rośliną Greków i Rzymian, symbolem szczęścia i długowieczności. Używana w medycynie, kuchni, magii ludowej, a także do ochrony domostw przed złem. Stosowana od wieków na kaszel, przeziębienia, niestrawność i jako środek antybakteryjny. Współcześnie nieodzowna przyprawa kuchni śródziemnomorskiej, ale i polskiej.",
    "cechy": [
      "Bardzo aromatyczna, dekoracyjna roślina",
      "Wyjątkowo odporna na suszę i mróz",
      "Bogactwo olejków eterycznych o szerokim zastosowaniu leczniczym i kulinarnym",
      "Wabi owady zapylające, a jej korzeń stabilizuje glebę"
    ],
    "zastosowanie_historyczne": [
      "Zioło lecznicze na kaszel, bóle brzucha, przeziębienia, trudno gojące się rany",
      "Przyprawa do pieczywa, mięs, serów, win, marynat, octów",
      "Stosowana w magii ludowej do odstraszania złych duchów",
      "Wieniec z lebiodki był symbolem szczęścia w antycznej Grecji"
    ],
    "ciekawostki": [
      "Nazwa 'oregano' pochodzi z greckiego: 'oros' (góra) i 'ganos' (radość), czyli 'radość gór'.",
      "W Polsce lebiodka była popularną przyprawą w kuchni staropolskiej do czasu upowszechnienia pieprzu i majeranku.",
      "Olejek z lebiodki jest jednym z najsilniejszych naturalnych antyseptyków."
    ],
    "zrodlo": [9,10]
  },
  "ciekawostki_kulturowe": [
    "W antycznej Grecji nowożeńcy otrzymywali wieńce z lebiodki jako symbol szczęścia i pomyślności.",
    "W Słowiańszczyźnie wieszano gałązki lebiodki nad drzwiami domostw, aby chronić przed złymi mocami.",
    "Na Podkarpaciu i w regionie świętokrzyskim lebiodka była podstawą domowych ziół na miłość i ochronę.",
    "W dawnych czasach wierzono, że zapach lebiodki odgania złe sny i zapewnia spokojny sen dzieciom.",
    "We Włoszech oregano było symbolem radości i wesela, a w Szkocji wykorzystywano je do aromatyzowania piwa i whisky.",
    "W krajach bałkańskich pęki lebiodki palono podczas obrzędów oczyszczających gospodarstwa z 'złej energii'."
  ],
  "permakultura": {
    "opis": "Lebiodka jest doskonałą rośliną do ogrodów permakulturowych – odporna, łatwa w uprawie, długowieczna, wspiera bioróżnorodność i chroni inne rośliny przed chorobami.",
    "funkcje": [
      "Tworzy gęste, aromatyczne kobierce ograniczające rozwój chwastów",
      "Wabi pszczoły, trzmiele i motyle, zwiększając zapylanie sąsiednich upraw",
      "Naturalny repelent na mszyce, mrówki i niektóre gąsienice",
      "Chroni grządki przed patogenami dzięki lotnym olejkom",
      "Nadaje się na obrzeża grządek, ścieżek, do upraw w donicach"
    ],
    "gildie": [
      "Idealna do uprawy z pomidorami, papryką, bazylią, cebulą, szałwią i marchewką",
      "Dobrze komponuje się w gildi z bylicą, truskawką, nagietkiem, a także jako obwódka ziół i warzyw"
